# Environment Variables for LeaveOS
# Copy this file to .env and fill in values

# Database — Use SQLite for local dev, Postgres for Docker/production
# SQLite (local dev):
DATABASE_URL=sqlite:///./leaveos.db
# PostgreSQL (Docker/production):
# DATABASE_URL=postgresql://leaveos:leaveos@localhost:5432/leaveos

# JWT Configuration
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Cloud (Phase 8)
GOOGLE_CLOUD_PROJECT=

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173
